# Copy to .env.monitor and adjust for the target host. Do not commit real secrets.
MONITOR_PROJECT_NAME=shared-monitor
MONITOR_NETWORK=shared_monitor

PROMETHEUS_IMAGE=prom/prometheus:latest
PROMETHEUS_DATA_DIR=/data/prometheus

LOKI_IMAGE=grafana/loki:latest
LOKI_DATA_DIR=/data/loki

PROMTAIL_IMAGE=grafana/promtail:latest
BASE_LOG_DIR=/data/logs

TEMPO_IMAGE=grafana/tempo:latest
TEMPO_DATA_DIR=/data/tempo
TEMPO_OTLP_GRPC_PORT=4317
TEMPO_OTLP_HTTP_PORT=4318

GRAFANA_IMAGE=grafana/grafana:latest
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_DATA_DIR=/data/grafana
