# Copy to .env.rabbitmq and adjust for the target host. Do not commit real secrets.
RABBITMQ_PROJECT_NAME=shared-rabbitmq
RABBITMQ_NETWORK=shared_rabbitmq
RABBITMQ_IMAGE=rabbitmq:3-management

RABBITMQ_USER=admin
RABBITMQ_PASS=CHANGE_ME
RABBITMQ_DATA_DIR=/data/rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
