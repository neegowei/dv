# --- Secrets & environment (never commit to public repo) ---
.env
.env.*
!.env.*.example
!.env.example

# --- Proxy: runtime nginx config (contains real domains / upstreams) ---
proxy/conf.d-enabled/*.conf
proxy/templates-enabled/

