# Copy to .env.db and adjust for the target host. Do not commit real secrets.
DB_PROJECT_NAME=shared-db
DB_NETWORK=shared_db

MYSQL_IMAGE=mysql:8
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=app
MYSQL_USER=admin
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATA_DIR=/data/mysql

REDIS_IMAGE=redis:7
REDIS_PASS=CHANGE_ME
REDIS_DATA_DIR=/data/redis

MONGO_IMAGE=mongo:7
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=CHANGE_ME
MONGO_DATA_DIR=/data/mongo
