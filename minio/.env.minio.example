# Copy to .env.minio and adjust for the target host. Do not commit real secrets.
MINIO_PROJECT_NAME=shared-minio
MINIO_NETWORK=shared_minio
PROXY_NETWORK=shared_proxy
MINIO_IMAGE=minio/minio:latest

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MIN_8_CHARS
MINIO_DATA_DIR=/data/minio
