# Copy to .env.proxy and adjust for the target host. Do not commit real secrets.
PROXY_PROJECT_NAME=shared-proxy
PROXY_NETWORK=shared_proxy
NGINX_IMAGE=nginx:latest
CERTBOT_IMAGE=certbot/certbot:v2.11.0
HTTP_PORT=80
HTTPS_PORT=443

CERTBOT_EMAIL=admin@example.test
CERTBOT_DOMAINS=monitor.example.test,store.example.test,admin.store.example.test
CERT_NAME=monitor.example.test
CERTBOT_STAGING=1

DOMAIN_MONITOR=monitor.example.test
DOMAIN_STORE=store.example.test
DOMAIN_ADMIN_STORE=admin.store.example.test
DOMAIN_MONITOR_CERT_NAME=monitor.example.test
DOMAIN_STORE_CERT_NAME=store.example.test
DOMAIN_ADMIN_STORE_CERT_NAME=admin.store.example.test

GRAFANA_UPSTREAM=host.docker.internal:3000
STORE_UPSTREAM=host.docker.internal:9001
ADMIN_STORE_UPSTREAM=host.docker.internal:8090
